ourier New" pitchFamily="34" charset="-120"/></a:rPr><a:t>No training data is given. Inputs are atomic fractions of Al, Cr, Cu, Fe, Hf,</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="17" name="Text 15"></p:cNvPr><p:cNvSpPr/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="406301" y="1701701"/><a:ext cx="6554623" cy="167580"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="l" indent="0" marL="0"><a:lnSpc><a:spcPts val="1320"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="1F1F1F"/></a:solidFill><a:latin typeface="Courier New" pitchFamily="34" charset="0"/><a:ea typeface="Courier New" pitchFamily="34" charset="-122"/><a:cs typeface="Courier New" pitchFamily="34" charset="-120"/></a:rPr><a:t>Mn, Mo, Nb, Si, Sn, Ta, Ti, V, Zr, and the summed fraction of all other</a:t></a:r><a:endParaRPr lang="en-US" sz="1050" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="18" name="Text 16"></p:cNvPr><p:cNvSpPr/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="406301" y="1869430"/><a:ext cx="6554623" cy="167580"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="l" indent="0" marL="0"><a:lnSpc><a:spcPts val="1320"/></a:lnSpc><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1050" dirty="0"><a:solidFill><a:srgbClr val="1F1F1F"/></a:solidFill><a:latin typeface="Courier New" pitchFamily="34" charset="0"/><a:ea typeface="Courier New" pitchFamily="34" charset="-122"/><a:cs typeface="Courier New" pitchFamily="34" charset="-120"/></a:rPr><a:t>elements; each row sums to 1. The target is Youn